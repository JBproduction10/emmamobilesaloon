# Copy this file's variables into Vercel → Project → Settings → Environment Variables.
# Each channel is independent — only set the block(s) you want active.
# Any channel whose variables are missing is skipped (no error), so you can
# enable email now and add SMS/WhatsApp later.

# ---- Email (via Gmail) ----
# GMAIL_USER: the Gmail address that will send the notification
# GMAIL_APP_PASSWORD: a 16-character Gmail "App Password" (NOT your normal password)
#   Create one at https://myaccount.google.com/apppasswords
#   (requires 2-Step Verification enabled on the Google account)
# NOTIFY_EMAIL: the address that should receive new booking emails (can be the same as GMAIL_USER)
GMAIL_USER=yourbusiness@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
NOTIFY_EMAIL=yourbusiness@gmail.com

# ---- SMS (via Twilio) ----
# Sign up at https://www.twilio.com, buy/verify a phone number capable of SMS.
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN: from the Twilio Console dashboard
# TWILIO_SMS_FROM: your Twilio phone number, e.g. +15551234567
# NOTIFY_PHONE: the phone number that should receive the SMS, e.g. +27679151923
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SMS_FROM=+15551234567
NOTIFY_PHONE=+27679151923

# ---- WhatsApp (via Twilio WhatsApp API) ----
# Easiest start: Twilio's WhatsApp Sandbox (https://www.twilio.com/docs/whatsapp/sandbox)
# for testing, then apply for a production WhatsApp sender when ready.
# TWILIO_WHATSAPP_FROM: the Twilio WhatsApp-enabled number, e.g. +14155238886 (sandbox default)
# NOTIFY_WHATSAPP: the WhatsApp number that should receive the message, e.g. +27679151923
TWILIO_WHATSAPP_FROM=+14155238886
NOTIFY_WHATSAPP=+27679151923
